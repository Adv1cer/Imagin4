# Copy to backend/.env for local development. All values below are placeholders --
# NOT secrets, and NOT suitable for production. Settings are loaded by
# app/core/config.py (pydantic-settings, env_prefix="APP_", env_file=".env").

APP_ENV=dev
APP_LOG_LEVEL=INFO

# --- Database (Postgres via pgbouncer in docker-compose; asyncpg driver) ---
APP_DATABASE_URL=postgresql+asyncpg://imaginv:imaginv@pgbouncer:5432/imaginv
# 5/5 is a laptop/CI-smoke-test value, NOT sized for real burst traffic -- a 100-VU burst
# test against a single api replica with these defaults exhausted the pool in seconds
# (see app/core/rate_limit.py's module docstring for the incident). These are PER
# REPLICA: if you scale `api` past 1 (docker-compose.yml's `nginx` service), divide
# whatever total you're aiming for by the replica count rather than setting the same
# large value on every replica.
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=5
APP_DB_POOL_TIMEOUT_S=5
APP_DB_POOL_PRE_PING=true

# "memory" = InMemoryJobQueue, process-local, gone on restart, NOT shared across API
#   replicas or the standalone scheduler/reconciler containers -- fine for local
#   smoke-testing without Postgres up. "postgres" = durable, shared PostgresJobQueue
#   (app/adapters/queue/postgres.py) -- required before running >1 API replica or
#   trusting job state across a restart/deploy. Run `pytest tests/integration` against a
#   real Postgres (or via testcontainers) after switching before trusting this in prod.
APP_QUEUE_BACKEND=memory

# Same reasoning as APP_QUEUE_BACKEND directly above, for generated image bytes instead
# of job state -- "memory" = InMemoryObjectStorage, process-local. "s3" = MinIO/S3 via
# S3ObjectStorage (app/adapters/storage/s3.py). REQUIRED alongside APP_QUEUE_BACKEND=
# postgres once the scheduler/reconciler run as separate containers from the API, or a
# generated image 404s when the API tries to serve it back. Run
# `pytest tests/integration/test_s3_object_storage.py -v` (needs Docker) after switching.
APP_STORAGE_BACKEND=memory

# --- Redis (rate limiting / pub-sub) ---
APP_REDIS_URL=redis://redis:6379/0
APP_REDIS_CONNECT_TIMEOUT_S=0.5

# --- Sessions / auth (opaque server-side session tokens, not JWT; see
#     app/domain/auth/sessions.py). cookie_secure should be true behind TLS. ---
APP_SESSION_COOKIE_NAME=imaginv_session
APP_SESSION_TTL_HOURS=12
APP_SESSION_IDLE_TTL_HOURS=2
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=lax
APP_CSRF_COOKIE_NAME=imaginv_csrf

# --- CORS ---
APP_CORS_ALLOW_ORIGINS_CSV=http://localhost:3000

# --- Admission / fairness defaults ---
APP_MAX_ACTIVE_JOBS_PER_USER=1
APP_MAX_QUEUED_JOBS_PER_USER=3
APP_GLOBAL_QUEUE_CAP=5000
APP_DEFAULT_COMFY_ACTIVE_SLOTS=2
# Extra jobs the scheduler may prefetch into Comfy's pending queue beyond the slot
# cap above. Keep 0 on a single shared GPU (DGX Spark); 1 reduces idle between jobs
# once the current generation is already occupying the GPU.
APP_COMFY_PENDING_BUFFER=0
APP_STALE_RUNNING_SECONDS=600
# Separate lane from the ComfyUI slot count above: Gemini (poster_infographic) is a
# network call to Google, not local-GPU work, so it doesn't need to share ComfyUI's
# conservative single-GPU cap. See app/core/config.py's comment on
# default_gemini_active_slots for why these are split.
APP_DEFAULT_GEMINI_ACTIVE_SLOTS=3
APP_PRIORITY_TIERS=4
APP_AGING_INCREMENT_PER_MINUTE=0.5

# --- Object storage (MinIO locally, S3-compatible) ---
APP_S3_ENDPOINT_URL=http://minio:9000
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_BUCKET=imaginv-assets
APP_S3_REGION=us-east-1
APP_SIGNED_URL_TTL_S=300

# --- ComfyUI: "mock" uses the deterministic in-repo MockComfyUIClient (default, works
#     without any ComfyUI process); "live" talks to a real ComfyUI instance's HTTP API
#     (see app/adapters/comfyui/live.py) at APP_COMFY_BASE_URL. Ordinary "Image"
#     generation (workflow image_basic) always uses this -- "Poster / Infographic"
#     always uses Gemini or OpenRouter regardless of this setting (see
#     APP_IMAGE_PROVIDER / APP_GEMINI_* / APP_OPENROUTER_* below).
#
#     To point at a real ComfyUI on another machine on your network (e.g. a GPU box):
#       APP_COMFY_MODE=live
#       APP_COMFY_BASE_URL=http://<that machine's IP>:8188   (NOT localhost/127.0.0.1 --
#         that would mean "inside this container", which isn't where ComfyUI is running)
#
#     APP_COMFY_MODEL_FAMILY picks which graph shape gets built (see
#     app/adapters/comfyui/live.py) -- filenames below MUST match exactly what's actually
#     installed on the target ComfyUI instance, or the job fails with a ComfyUI-side
#     graph error:
#       "checkpoint"     -- single-file model (e.g. classic SDXL) via CheckpointLoaderSimple.
#                           Only APP_COMFY_CHECKPOINT_NAME matters.
#       "qwen_image"     -- Qwen-Image split-file (UNET + CLIP type=qwen_image + VAE +
#                           ModelSamplingAuraFlow). Uses APP_COMFY_DIFFUSION_MODEL_NAME /
#                           CLIP / VAE. See docs.comfy.org qwen-image tutorial.
#       "z_image_turbo"  -- Z-Image Turbo (same AuraFlow skeleton, CLIP type=lumina2,
#                           TE=qwen_3_4b, VAE=ae). Fast student lane; ~8 steps, cfg=1.
#
#     DGX Spark production dual-lane (see docker/comfyui-worker/DGX_MODELS_RUNBOOK.md):
#       student  = z_image_turbo + z_image_turbo_bf16.safetensors (8 steps, cfg 1)
#       personnel = qwen_image Lightning 4-step UNet (4 steps, cfg 1)
#     Workers: 2 only unless MPS_RUNBOOK.md is validated.
#
#     Multiple GPU workers (see docker-compose.yml's comfyui-worker-1..4): set
#     APP_COMFY_WORKER_BASE_URLS_CSV to a comma-separated list of whichever of their
#     service URLs you're actually running -- this WINS over APP_COMFY_BASE_URL
#     entirely when non-empty, and lets the scheduler dispatch concurrently-claimed
#     jobs to more than one ComfyUI process. Also bump APP_DEFAULT_COMFY_ACTIVE_SLOTS to
#     match how many workers you list (one in-flight job per worker).
#
#     DGX Spark GB10 (128GB unified, --highvram Qwen ~28GB/worker): use **2 workers**.
#     1 is the safe minimum; 3–4 previously CUBLAS-crashed without MPS (see
#     docker/comfyui-worker/MPS_RUNBOOK.md). Do not set CUDA_MPS_* until the host
#     daemon is up.
#
#     Throughput path (2026-08): Qwen-Image-2512 Lightning 4-step UNet + CFG 1.0:
#       APP_COMFY_DIFFUSION_MODEL_NAME=qwen_image_2512_fp8_e4m3fn_scaled_comfyui_4steps_v1.0.safetensors
#       (download into ComfyUI/models/diffusion_models/ from
#        https://huggingface.co/lightx2v/Qwen-Image-2512-Lightning)
#       APP_COMFY_STEPS=4
#       APP_COMFY_CFG_SCALE=1.0
#     Leave blank APP_COMFY_WORKER_BASE_URLS_CSV to keep single-worker APP_COMFY_BASE_URL. ---
APP_COMFY_MODE=mock
APP_COMFY_BASE_URL=http://mock-comfyui:8188
APP_COMFY_WORKER_BASE_URLS_CSV=
# DGX Spark recommended (2 workers on host ports):
# APP_COMFY_WORKER_BASE_URLS_CSV=http://10.7.2.63:8188,http://10.7.2.63:8189
# APP_DEFAULT_COMFY_ACTIVE_SLOTS=2
# In-compose network names (when api talks on the docker network):
# APP_COMFY_WORKER_BASE_URLS_CSV=http://comfyui-worker-1:8188,http://comfyui-worker-2:8188
# 4 workers (only after MPS_RUNBOOK.md):
# APP_COMFY_WORKER_BASE_URLS_CSV=http://comfyui-worker-1:8188,http://comfyui-worker-2:8188,http://comfyui-worker-3:8188,http://comfyui-worker-4:8188
APP_COMFY_REQUEST_TIMEOUT_S=10.0
APP_COMFY_MODEL_FAMILY=qwen_image
APP_COMFY_CHECKPOINT_NAME=sd_xl_base_1.0.safetensors
APP_COMFY_DIFFUSION_MODEL_NAME=qwen_image_2512_fp8_e4m3fn.safetensors
APP_COMFY_CLIP_NAME=qwen_2.5_vl_7b_fp8_scaled.safetensors
APP_COMFY_VAE_NAME=qwen_image_vae.safetensors
APP_COMFY_MODEL_SAMPLING_SHIFT=3.1
APP_COMFY_SAMPLER_NAME=euler
APP_COMFY_SCHEDULER=simple
APP_COMFY_STEPS=20
APP_COMFY_CFG_SCALE=4.0
APP_COMFY_NEGATIVE_PROMPT=

# --- Optional second "model profile" (2026-08-19) -- lets a caller pick a different
#     model/quality tier per request via inputs.model_profile="personnel" on
#     POST /v1/generations (validated server-side against this allowlist -- see
#     app/domain/jobs/comfy_profiles.py). Built for the external agentflow
#     integration: their own master-prompt/UI decides which role ("student" = the
#     default APP_COMFY_* model above, "personnel" = this one) gets which tier and
#     just sends us the resolved profile key; we never accept a raw checkpoint
#     filename/sampler/steps/cfg from the caller. Leave BOTH
#     APP_COMFY_PERSONNEL_CHECKPOINT_NAME and APP_COMFY_PERSONNEL_DIFFUSION_MODEL_NAME
#     empty (default) to not register "personnel" at all -- a request for it then
#     fails admission with 400 "unknown model_profile" instead of silently reusing the
#     student model above. ---
APP_COMFY_PERSONNEL_CHECKPOINT_NAME=
APP_COMFY_PERSONNEL_MODEL_FAMILY=checkpoint
APP_COMFY_PERSONNEL_DIFFUSION_MODEL_NAME=
APP_COMFY_PERSONNEL_CLIP_NAME=
APP_COMFY_PERSONNEL_VAE_NAME=
APP_COMFY_PERSONNEL_MODEL_SAMPLING_SHIFT=3.1
APP_COMFY_PERSONNEL_SAMPLER_NAME=euler
APP_COMFY_PERSONNEL_SCHEDULER=normal
APP_COMFY_PERSONNEL_STEPS=30
APP_COMFY_PERSONNEL_CFG_SCALE=7.0
APP_COMFY_PERSONNEL_NEGATIVE_PROMPT=

# --- Per-request field overrides on top of model_profile (2026-08-19) -- lets the
#     agentflow team's own master prompt send inputs.model_overrides (a dict of
#     checkpoint_name/diffusion_model_name/clip_name/vae_name/sampler_name/scheduler/
#     steps/cfg_scale/negative_prompt) instead of only choosing between "student"/
#     "personnel" -- see app/domain/jobs/comfy_overrides.py. Every *_CSV list below is
#     EMPTY by default = that field cannot be overridden at all (request gets 400).
#     List the EXACT filenames that exist on your ComfyUI worker(s), comma-separated --
#     there is no discovery/validation beyond string match, a wrong name still fails
#     the job with a ComfyUI-side error, this only stops OFF-list names from being
#     tried at all. model_family is intentionally not overridable this way -- it's
#     still only selected via model_profile (student/personnel above). ---
APP_COMFY_ALLOWED_CHECKPOINTS_CSV=
APP_COMFY_ALLOWED_DIFFUSION_MODELS_CSV=
APP_COMFY_ALLOWED_CLIPS_CSV=
APP_COMFY_ALLOWED_VAES_CSV=
APP_COMFY_ALLOWED_SAMPLERS_CSV=euler,euler_ancestral,dpmpp_2m,dpmpp_2m_sde,dpmpp_3m_sde
APP_COMFY_ALLOWED_SCHEDULERS_CSV=normal,karras,simple,sgm_uniform
# Bounds for the numeric overrides -- keep these sane for your actual GPU/VRAM budget;
# see the 2026-08-18 burst-test incident notes in app/core/rate_limit.py for why an
# unbounded steps/cfg value is a real capacity risk, not a hypothetical one.
APP_COMFY_OVERRIDE_MIN_STEPS=1
APP_COMFY_OVERRIDE_MAX_STEPS=50
APP_COMFY_OVERRIDE_MIN_CFG_SCALE=1.0
APP_COMFY_OVERRIDE_MAX_CFG_SCALE=15.0
APP_COMFY_OVERRIDE_MAX_NEGATIVE_PROMPT_CHARS=2000

# --- Gemini (Google AI Studio) -- APP_GEMINI_API_KEY always powers real text chat
#     replies (POST /v1/conversations/{id}/assistant-reply) and the semantic router,
#     regardless of APP_IMAGE_PROVIDER above. It ALSO powers the "Poster / Infographic"
#     image workflow specifically (see app/domain/jobs/workflow_registry.py's `backend`
#     field / app/adapters/routing_comfyui.py) when APP_IMAGE_PROVIDER=gemini (the
#     default) -- but not when APP_IMAGE_PROVIDER=openrouter, in which case
#     APP_OPENROUTER_API_KEY below is what actually renders poster/infographic pixels,
#     though this key is still required for chat/routing to work either way. Ordinary
#     "Image" generation still goes through ComfyUI (mock/live), unaffected by this key.
#     Leave blank to disable chat entirely (chat replies 503) -- poster jobs then fail
#     cleanly with error_detail "gemini_not_configured" (if APP_IMAGE_PROVIDER=gemini) or
#     "openrouter_not_configured" (if APP_IMAGE_PROVIDER=openrouter and that key is also
#     unset) instead of silently using ComfyUI.
#     Get a key at https://aistudio.google.com/ -- do not commit a real key to this repo;
#     put it only in your local untracked .env. IMPORTANT: as of 2026-08, NEITHER Gemini
#     image model (flash or pro) has a free API tier -- image generation via this key is
#     billed per-image even on gemini-3.1-flash-image. Text chat may still have a free
#     tier depending on your project. Watch usage at https://aistudio.google.com/ -> Spend.
#     Model names below are current as of 2026-08 -- Google retires model names
#     periodically (gemini-2.0-flash and gemini-2.5-flash both stopped working for new
#     API keys while this feature was being built). If you get a 404 "no longer
#     available", check https://ai.google.dev/gemini-api/docs/models and update these.
#     gemini-3-pro-image ("Nano Banana Pro") produces higher quality but is more prone to
#     503 UNAVAILABLE ("high demand") and slower generation than gemini-3.1-flash-image
#     ("Nano Banana 2") -- prefer flash-image unless you specifically need pro quality. ---
APP_GEMINI_API_KEY=
APP_GEMINI_TEXT_MODEL=gemini-3.6-flash
APP_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Text replies are fast; keep this tight so a stuck chat request fails fast.
APP_GEMINI_REQUEST_TIMEOUT_S=30.0
# Image generation (especially a long, detail-heavy poster prompt) routinely takes
# longer than plain text -- give it more room before giving up.
APP_GEMINI_IMAGE_REQUEST_TIMEOUT_S=90.0
# Best-effort grounded Google Search call used by the chat router to try to fill in
# missing POSTER/INFOGRAPHIC fields before asking the user (app/domain/chat/routing.py's
# RESEARCH_SYSTEM_INSTRUCTION). Kept tighter than the plain-text timeout above since it's
# optional -- a smart-message request can involve up to 3 sequential Gemini calls
# (classify -> research -> re-classify) when this triggers, so the frontend's request
# timeout for POST .../smart-message is set well above
# APP_GEMINI_REQUEST_TIMEOUT_S*2 + APP_GEMINI_RESEARCH_TIMEOUT_S to avoid the client
# aborting a request the backend is still legitimately working on (see
# frontend/src/api/endpoints.ts:createSmartMessage).
APP_GEMINI_RESEARCH_TIMEOUT_S=20.0

# --- Brain backend (chat replies + semantic intent router) -- "gemini" (default) uses
#     the Gemini settings above. "qwen" instead points app.state.gemini_text_client at a
#     self-hosted Qwen3.8-27B served over vLLM (see docker-compose.yml's `qwen-brain`
#     service, profile "brain": `docker compose --profile brain up -d qwen-brain`) --
#     see Settings.brain_backend's docstring (app/core/config.py) for the VRAM budget
#     vs ComfyUI worker count tradeoff and the research_missing_fields feature gap
#     (no grounded web search under "qwen"). UNVERIFIED against real GPU hardware as of
#     2026-08-18 -- confirm qwen-brain reaches healthy and serves a real completion
#     before flipping this to "qwen". ---
APP_BRAIN_BACKEND=gemini
APP_QWEN_BASE_URL=http://qwen-brain:8000
APP_QWEN_TEXT_MODEL=Qwen/Qwen3.8-27B-FP8
APP_QWEN_REQUEST_TIMEOUT_S=30.0
APP_QWEN_RESEARCH_TIMEOUT_S=20.0
# Only needed if the Qwen checkpoint you point at is gated on Hugging Face.
HUGGING_FACE_HUB_TOKEN=

# --- Image generation provider switch for "Poster / Infographic" jobs ONLY -- chat
#     replies/routing/research above always use Gemini regardless of this setting, and
#     ordinary "Image" generation always uses ComfyUI (APP_COMFY_MODE above) regardless
#     of this setting too. "gemini" (default) uses APP_GEMINI_IMAGE_MODEL directly.
#     "openrouter" instead routes poster/infographic pixel-generation through
#     OpenRouter's unified Image API (APP_OPENROUTER_* below) -- useful if you want a
#     different underlying model (Seedream, FLUX, etc.) or a separate billing account
#     without touching code. Whichever provider you do NOT select here doesn't need its
#     key configured at all. ---

# --- OpenRouter (https://openrouter.ai/) -- only used when APP_IMAGE_PROVIDER=openrouter
#     above. Get a key at https://openrouter.ai/keys -- do not commit a real key, put it
#     only in your local untracked .env. Uses OpenRouter's dedicated Image API
#     (POST {APP_OPENROUTER_BASE_URL}/images, not chat/completions), which returns
#     base64-encoded image data and bills all-or-nothing (a failed generation is not
#     billed). Model slugs are OpenRouter's own catalog names -- confirmed real/current
#     as of 2026-08: "google/gemini-3-pro-image-preview" ("Nano Banana Pro", the
#     default below), "google/gemini-2.5-flash-image" ("Nano Banana", cheaper/faster),
#     "bytedance-seed/seedream-4.5", "black-forest-labs/flux.2-pro" -- browse
#     https://openrouter.ai/models?output_modalities=image for the current full list;
#     like Gemini's own model names, these rotate over time and a 400/404 "model not
#     found" is a config fix here, not a bug. Leave APP_OPENROUTER_API_KEY blank while
#     APP_IMAGE_PROVIDER=openrouter and poster jobs fail cleanly with error_detail
#     "openrouter_not_configured" instead of silently using ComfyUI or Gemini. ---
APP_IMAGE_PROVIDER=gemini
APP_OPENROUTER_API_KEY=
APP_OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image-preview
APP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Same reasoning as APP_GEMINI_IMAGE_REQUEST_TIMEOUT_S above -- a detail-heavy poster
# prompt routinely takes longer than a simple image.
APP_OPENROUTER_IMAGE_REQUEST_TIMEOUT_S=90.0

# --- Rate limiting (requests per minute per identity) ---
# 2026-08-18: these were defined but not enforced anywhere until now -- see
# app/api/deps.py:rate_limited() and app/core/rate_limit.py.
APP_RL_LOGIN_PER_MIN=10
APP_RL_REFRESH_PER_MIN=30
APP_RL_MESSAGE_PER_MIN=60
APP_RL_GENERATION_PER_MIN=10
APP_RL_SSE_CONNECT_PER_MIN=30

# --- Admission control (app/core/rate_limit.py:AdmissionGate) ---
# FLEET-WIDE in-flight cap for job-admission endpoints (POST /v1/generations,
# /smart-message, /agent/message, /pending-actions/{id}/confirm), shared via Redis across
# every api replica -- protects PgBouncer/Postgres capacity from a burst larger than the
# fleet can serve. Size to your PgBouncer DEFAULT_POOL_SIZE (docker-compose.yml), NOT to
# any single replica's own APP_DB_POOL_SIZE + APP_DB_MAX_OVERFLOW. Does not need dividing
# when you add more api replicas. 0 disables the gate.
APP_ADMISSION_MAX_INFLIGHT=200
APP_ADMISSION_GATE_TTL_S=60

# --- comfyui-worker-* container env (used by docker-compose.yml's volume mount, not
#     read by the app) -- point this at the actual ComfyUI checkout on the host you
#     currently run `python main.py` from natively; both worker containers bind-mount
#     it read-write so they share the same models/custom_nodes/output. ---
COMFYUI_HOST_PATH=/home/nvidia/comfyui/ComfyUI

# --- Postgres container env (used by the `postgres` docker-compose service itself,
#     not read by the app -- keep in sync with APP_DATABASE_URL's user/pass/db) ---
POSTGRES_USER=imaginv
POSTGRES_PASSWORD=imaginv
POSTGRES_DB=imaginv

# --- MinIO container env (used by the `minio`/`minio-init` docker-compose services) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
