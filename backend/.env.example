# Copy to backend/.env for local development. All values below are placeholders --
# NOT secrets, and NOT suitable for production. Settings are loaded by
# app/core/config.py (pydantic-settings, env_prefix="APP_", env_file=".env").

APP_ENV=dev
APP_LOG_LEVEL=INFO

# --- Database (Postgres via pgbouncer in docker-compose; asyncpg driver) ---
APP_DATABASE_URL=postgresql+asyncpg://imaginv:imaginv@pgbouncer:5432/imaginv
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=5
APP_DB_POOL_TIMEOUT_S=5
APP_DB_POOL_PRE_PING=true

# --- Redis (rate limiting / pub-sub) ---
APP_REDIS_URL=redis://redis:6379/0
APP_REDIS_CONNECT_TIMEOUT_S=0.5

# --- Sessions / auth (opaque server-side session tokens, not JWT; see
#     app/domain/auth/sessions.py). cookie_secure should be true behind TLS. ---
APP_SESSION_COOKIE_NAME=imaginv_session
APP_SESSION_TTL_HOURS=12
APP_SESSION_IDLE_TTL_HOURS=2
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=lax
APP_CSRF_COOKIE_NAME=imaginv_csrf

# --- CORS ---
APP_CORS_ALLOW_ORIGINS_CSV=http://localhost:3000

# --- Admission / fairness defaults ---
APP_MAX_ACTIVE_JOBS_PER_USER=1
APP_MAX_QUEUED_JOBS_PER_USER=3
APP_GLOBAL_QUEUE_CAP=5000
APP_DEFAULT_COMFY_ACTIVE_SLOTS=1
APP_PRIORITY_TIERS=4
APP_AGING_INCREMENT_PER_MINUTE=0.5

# --- Object storage (MinIO locally, S3-compatible) ---
APP_S3_ENDPOINT_URL=http://minio:9000
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_BUCKET=imaginv-assets
APP_S3_REGION=us-east-1
APP_SIGNED_URL_TTL_S=300

# --- ComfyUI: "mock" uses the deterministic in-repo MockComfyUIClient (default, works
#     without any ComfyUI process); "live" talks to APP_COMFY_BASE_URL over HTTP. The
#     docker-compose mock-comfyui service is a placeholder target for "live" mode during
#     local integration testing -- see README.md "mock vs live ComfyUI" section. ---
APP_COMFY_MODE=mock
APP_COMFY_BASE_URL=http://mock-comfyui:8188
APP_COMFY_REQUEST_TIMEOUT_S=10.0

# --- Rate limiting (requests per minute per identity) ---
APP_RL_LOGIN_PER_MIN=10
APP_RL_REFRESH_PER_MIN=30
APP_RL_MESSAGE_PER_MIN=60
APP_RL_GENERATION_PER_MIN=10
APP_RL_SSE_CONNECT_PER_MIN=30

# --- Postgres container env (used by the `postgres` docker-compose service itself,
#     not read by the app -- keep in sync with APP_DATABASE_URL's user/pass/db) ---
POSTGRES_USER=imaginv
POSTGRES_PASSWORD=imaginv
POSTGRES_DB=imaginv

# --- MinIO container env (used by the `minio`/`minio-init` docker-compose services) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
