# Copy to .env.local for local overrides. Backend base URL the app talks to
# (cookie-based session auth; every request is sent with credentials: 'include').
#
# IMPORTANT: this MUST use the same hostname the frontend page itself is loaded from
# (this app runs on http://localhost:3000, see vite.config.ts). Browsers treat
# "127.0.0.1" and "localhost" as different sites even though they're the same
# machine, so a SameSite=Lax session cookie set by the backend at 127.0.0.1 will
# silently be dropped on the next fetch() from a localhost page -- every call after
# login/register looks like it's not authenticated even though login "succeeded".
# Keep both sides on "localhost" (or both on "127.0.0.1", but then also change
# APP_CORS_ALLOW_ORIGINS_CSV in backend/.env to http://127.0.0.1:3000 to match).
VITE_API_BASE_URL=http://localhost:8000
